# LLM provider: gemini | groq | ollama | mock (mock = offline templates, for tests only)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=auto   # auto = newest stable Flash on your key
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_MODEL=llama3.1
OLLAMA_HOST=http://localhost:11434
# minimum seconds between LLM calls (free-tier throttle)
LLM_MIN_INTERVAL_S=4.0

PEXELS_API_KEY=
PIXABAY_API_KEY=

# optional: path to ffmpeg (only used for audio probing / placeholder images; auto-detected otherwise)
FFMPEG_BIN=
# Remotion: Chromium tabs per render (default = CPU cores / RENDER_WORKERS) and voice gain (music sits at 10% of it)
REMOTION_CONCURRENCY=
VOICE_VOLUME=2.3
# 1 = burn a small "AI-generated" tag into the top-right of every video (off by default)
SHOW_AI_LABEL=0

PRIMARY_METRIC=installs_per_1k_views
EXPLORE_RATIO=0.3
GEN1_RENDER_COUNT=12
SCRIPTED_COUNT=60
RENDER_WORKERS=1   # Remotion already uses all cores per video; 2 workers was slower in testing
CREATOR_REEL_COST_INR=10000
CREATOR_TURNAROUND_DAYS=7
SIM_SEED=42

# Paid Gemini usage is allowed (approved 2026-09-25); every call's ₹ cost is logged and capped per day.
# Prices per 1M tokens (check ai.google.dev/gemini-api/docs/pricing for your model).
GEMINI_DAILY_BUDGET_INR=500
GEMINI_PRICE_INPUT_USD_PER_M=0.30
GEMINI_PRICE_OUTPUT_USD_PER_M=2.50
USD_INR=88

# Instagram Reels research via Apify (paid per result; FREE plan = $5/month credit)
APIFY_API_TOKEN=
APIFY_MONTHLY_BUDGET_USD=4.5
APIFY_TRANSCRIPTS=0

# D8 market research (YouTube Data API v3 — free 10,000 units/day)
YOUTUBE_API_KEY=
YOUTUBE_DAILY_QUOTA_BUDGET=8000

# Magnific REST API: lets an approved batch call Magnific itself (credits capped per batch)
MAGNIFIC_API_KEY=
MAGNIFIC_WEBHOOK_SECRET=
